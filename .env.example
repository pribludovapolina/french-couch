# Переменные окружения. На Render они задаются в разделе Environment.
# Для локальной работы с настоящей базой скопируй этот файл в .env и впиши токен; файл .env в git не попадает.
# Без этих двух переменных сервер использует локальный файл data/cahier.db.

TURSO_DATABASE_URL=libsql://fr-pribludovapolina.aws-eu-north-1.turso.io
# Токен создаётся в Turso: страница базы → Create Token. Никому его не показывай.
TURSO_AUTH_TOKEN=

# Необязательно. Если задан, зарегистрироваться сможет только тот, кто знает этот код.
# INVITE_CODE=

# Необязательно. Сколько всего аккаунтов можно создать (по умолчанию 200).
# MAX_USERS=200

# Порт; Render задаёт его сам.
# PORT=3000
