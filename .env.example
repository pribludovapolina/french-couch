# Переменные окружения. Локально всё работает и без них; на Render они задаются в разделе Environment.

# Где лежит файл базы SQLite. По умолчанию ./data/cahier.db рядом с сервером.
# На Render это должен быть путь на постоянном диске, иначе база стирается при каждом перезапуске.
# DB_FILE=/var/data/cahier.db

# Необязательно. Если задан, зарегистрироваться сможет только тот, кто знает этот код.
# INVITE_CODE=

# Необязательно. Сколько всего аккаунтов можно создать (по умолчанию 200).
# MAX_USERS=200

# Порт; Render задаёт его сам.
# PORT=3000
